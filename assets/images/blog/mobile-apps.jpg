<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="mobileBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#mobileBg)"/>
  
  <!-- Phone 1 -->
  <rect x="200" y="80" width="120" height="240" rx="20" fill="#1f2937"/>
  <rect x="210" y="100" width="100" height="180" fill="#111827"/>
  <circle cx="260" cy="95" r="3" fill="#6b7280"/>
  <rect x="240" y="285" width="40" height="6" rx="3" fill="#6b7280"/>
  
  <!-- Phone 1 Screen Content -->
  <rect x="220" y="110" width="80" height="20" rx="4" fill="#3b82f6"/>
  <rect x="220" y="140" width="60" height="8" fill="#10b981"/>
  <rect x="220" y="155" width="70" height="8" fill="#f59e0b"/>
  <rect x="220" y="170" width="50" height="8" fill="#ef4444"/>
  
  <circle cx="240" cy="200" r="15" fill="#8b5cf6"/>
  <circle cx="270" cy="200" r="15" fill="#06b6d4"/>
  <circle cx="240" cy="230" r="15" fill="#10b981"/>
  <circle cx="270" cy="230" r="15" fill="#f59e0b"/>
  
  <!-- Phone 2 -->
  <rect x="480" y="80" width="120" height="240" rx="20" fill="#374151"/>
  <rect x="490" y="100" width="100" height="180" fill="#1f2937"/>
  <circle cx="540" cy="95" r="3" fill="#9ca3af"/>
  <rect x="520" y="285" width="40" height="6" rx="3" fill="#9ca3af"/>
  
  <!-- Phone 2 Screen Content -->
  <rect x="500" y="110" width="80" height="15" rx="3" fill="#ef4444"/>
  <rect x="500" y="135" width="80" height="15" rx="3" fill="#f59e0b"/>
  <rect x="500" y="160" width="80" height="15" rx="3" fill="#10b981"/>
  
  <rect x="510" y="190" width="25" height="25" rx="4" fill="#3b82f6"/>
  <rect x="545" y="190" width="25" height="25" rx="4" fill="#8b5cf6"/>
  <rect x="510" y="225" width="25" height="25" rx="4" fill="#06b6d4"/>
  <rect x="545" y="225" width="25" height="25" rx="4" fill="#f97316"/>
  
  <!-- Floating Elements -->
  <circle cx="100" cy="100" r="30" fill="#10b981" opacity="0.8"/>
  <text x="100" y="108" text-anchor="middle" fill="white" font-family="Arial" font-size="14" font-weight="bold">iOS</text>
  
  <rect x="650" y="120" width="60" height="60" rx="8" fill="#3ddc84" opacity="0.8"/>
  <text x="680" y="155" text-anchor="middle" fill="white" font-family="Arial" font-size="12" font-weight="bold">Android</text>
  
  <!-- Title -->
  <text x="400" y="50" text-anchor="middle" fill="white" font-family="Arial" font-size="28" font-weight="bold">Mobil Tətbiqlər</text>
  
  <!-- Connection Lines -->
  <path d="M 320 200 Q 400 150 480 200" stroke="white" stroke-width="2" fill="none" opacity="0.6"/>
  
  <!-- Decorative Elements -->
  <circle cx="700" cy="300" r="20" fill="white" opacity="0.2"/>
  <circle cx="80" cy="300" r="25" fill="white" opacity="0.15"/>
  <rect x="50" y="200" width="40" height="40" rx="6" fill="white" opacity="0.2"/>
</svg>