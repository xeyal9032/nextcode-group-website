<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="aiBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="brainGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0.3" />
    </radialGradient>
  </defs>
  <rect width="800" height="400" fill="url(#aiBg)"/>
  
  <!-- Central Brain/AI Core -->
  <circle cx="400" cy="200" r="80" fill="url(#brainGlow)"/>
  <circle cx="400" cy="200" r="60" fill="none" stroke="white" stroke-width="2" opacity="0.6"/>
  <circle cx="400" cy="200" r="40" fill="none" stroke="white" stroke-width="1" opacity="0.4"/>
  
  <!-- Neural Network Nodes -->
  <circle cx="300" cy="120" r="12" fill="#10b981"/>
  <circle cx="350" cy="100" r="10" fill="#f59e0b"/>
  <circle cx="450" cy="100" r="10" fill="#ef4444"/>
  <circle cx="500" cy="120" r="12" fill="#8b5cf6"/>
  
  <circle cx="280" cy="280" r="12" fill="#06b6d4"/>
  <circle cx="330" cy="300" r="10" fill="#10b981"/>
  <circle cx="470" cy="300" r="10" fill="#f59e0b"/>
  <circle cx="520" cy="280" r="12" fill="#ef4444"/>
  
  <circle cx="200" cy="200" r="15" fill="#8b5cf6"/>
  <circle cx="600" cy="200" r="15" fill="#06b6d4"/>
  
  <!-- Connection Lines -->
  <path d="M 300 120 Q 350 160 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 350 100 Q 375 150 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 450 100 Q 425 150 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 500 120 Q 450 160 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  
  <path d="M 280 280 Q 340 240 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 330 300 Q 365 250 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 470 300 Q 435 250 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 520 280 Q 460 240 400 200" stroke="white" stroke-width="2" fill="none" opacity="0.7"/>
  
  <path d="M 200 200 Q 300 200 400 200" stroke="white" stroke-width="3" fill="none" opacity="0.8"/>
  <path d="M 600 200 Q 500 200 400 200" stroke="white" stroke-width="3" fill="none" opacity="0.8"/>
  
  <!-- Data Flow Particles -->
  <circle cx="250" cy="160" r="3" fill="#60a5fa" opacity="0.8">
    <animate attributeName="cx" values="250;350;400" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.8;0.4;0" dur="2s" repeatCount="indefinite"/>
  </circle>
  
  <circle cx="550" cy="240" r="3" fill="#34d399" opacity="0.8">
    <animate attributeName="cx" values="550;450;400" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.8;0.4;0" dur="2s" repeatCount="indefinite"/>
  </circle>
  
  <!-- AI Symbols -->
  <rect x="100" y="80" width="60" height="40" rx="8" fill="#1f2937" opacity="0.9"/>
  <text x="130" y="105" text-anchor="middle" fill="white" font-family="Arial" font-size="14" font-weight="bold">ML</text>
  
  <rect x="640" y="280" width="60" height="40" rx="8" fill="#1f2937" opacity="0.9"/>
  <text x="670" y="305" text-anchor="middle" fill="white" font-family="Arial" font-size="14" font-weight="bold">AI</text>
  
  <circle cx="150" cy="320" r="25" fill="#374151" opacity="0.9"/>
  <text x="150" y="328" text-anchor="middle" fill="white" font-family="Arial" font-size="12" font-weight="bold">DL</text>
  
  <!-- Title -->
  <text x="400" y="50" text-anchor="middle" fill="white" font-family="Arial" font-size="28" font-weight="bold">Süni İntellekt</text>
  
  <!-- Decorative Elements -->
  <circle cx="80" cy="200" r="8" fill="white" opacity="0.3"/>
  <circle cx="720" cy="150" r="12" fill="white" opacity="0.25"/>
  <rect x="50" y="350" width="25" height="25" rx="4" fill="white" opacity="0.2"/>
  <rect x="700" y="50" width="30" height="30" rx="6" fill="white" opacity="0.2"/>
</svg>