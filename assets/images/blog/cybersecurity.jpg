<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="cyberBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f172a;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="shieldGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:0.3" />
    </radialGradient>
    <linearGradient id="lockGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fbbf24;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f59e0b;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#cyberBg)"/>
  
  <!-- Central Shield -->
  <path d="M 400 120 L 450 140 L 450 220 Q 450 250 400 270 Q 350 250 350 220 L 350 140 Z" fill="url(#shieldGlow)" stroke="white" stroke-width="2"/>
  
  <!-- Lock Symbol in Shield -->
  <rect x="385" y="180" width="30" height="25" rx="3" fill="url(#lockGradient)"/>
  <path d="M 390 180 Q 390 170 400 170 Q 410 170 410 180" stroke="url(#lockGradient)" stroke-width="3" fill="none"/>
  <circle cx="400" cy="192" r="3" fill="#1e293b"/>
  
  <!-- Binary Code Background -->
  <text x="100" y="80" fill="#10b981" font-family="monospace" font-size="12" opacity="0.6">01001000 01100001 01100011 01101011</text>
  <text x="500" y="100" fill="#ef4444" font-family="monospace" font-size="12" opacity="0.6">11010010 10110101 01001101</text>
  <text x="150" y="350" fill="#3b82f6" font-family="monospace" font-size="12" opacity="0.6">10101010 11110000 01010101</text>
  <text x="550" y="370" fill="#8b5cf6" font-family="monospace" font-size="12" opacity="0.6">01110011 01100101 01100011</text>
  
  <!-- Firewall Lines -->
  <rect x="200" y="150" width="4" height="100" fill="#ef4444" opacity="0.7">
    <animate attributeName="opacity" values="0.7;0.3;0.7" dur="2s" repeatCount="indefinite"/>
  </rect>
  <rect x="210" y="160" width="4" height="80" fill="#ef4444" opacity="0.5">
    <animate attributeName="opacity" values="0.5;0.2;0.5" dur="2.5s" repeatCount="indefinite"/>
  </rect>
  <rect x="220" y="140" width="4" height="120" fill="#ef4444" opacity="0.6">
    <animate attributeName="opacity" values="0.6;0.2;0.6" dur="1.8s" repeatCount="indefinite"/>
  </rect>
  
  <rect x="576" y="150" width="4" height="100" fill="#10b981" opacity="0.7">
    <animate attributeName="opacity" values="0.7;0.3;0.7" dur="2.2s" repeatCount="indefinite"/>
  </rect>
  <rect x="586" y="160" width="4" height="80" fill="#10b981" opacity="0.5">
    <animate attributeName="opacity" values="0.5;0.2;0.5" dur="2.8s" repeatCount="indefinite"/>
  </rect>
  <rect x="596" y="140" width="4" height="120" fill="#10b981" opacity="0.6">
    <animate attributeName="opacity" values="0.6;0.2;0.6" dur="1.5s" repeatCount="indefinite"/>
  </rect>
  
  <!-- Threat Indicators -->
  <circle cx="150" cy="150" r="8" fill="#ef4444">
    <animate attributeName="r" values="8;12;8" dur="1.5s" repeatCount="indefinite"/>
  </circle>
  <text x="150" y="135" text-anchor="middle" fill="#ef4444" font-family="Arial" font-size="10" font-weight="bold">!</text>
  
  <circle cx="650" cy="250" r="8" fill="#f59e0b">
    <animate attributeName="r" values="8;12;8" dur="2s" repeatCount="indefinite"/>
  </circle>
  <text x="650" y="235" text-anchor="middle" fill="#f59e0b" font-family="Arial" font-size="10" font-weight="bold">⚠</text>
  
  <!-- Security Icons -->
  <rect x="80" y="280" width="40" height="30" rx="5" fill="#374151" stroke="#10b981" stroke-width="2"/>
  <text x="100" y="300" text-anchor="middle" fill="#10b981" font-family="Arial" font-size="12" font-weight="bold">VPN</text>
  
  <circle cx="700" cy="120" r="20" fill="#374151" stroke="#3b82f6" stroke-width="2"/>
  <text x="700" y="127" text-anchor="middle" fill="#3b82f6" font-family="Arial" font-size="10" font-weight="bold">SSL</text>
  
  <rect x="120" y="200" width="35" height="25" rx="4" fill="#374151" stroke="#8b5cf6" stroke-width="2"/>
  <text x="137" y="217" text-anchor="middle" fill="#8b5cf6" font-family="Arial" font-size="9" font-weight="bold">2FA</text>
  
  <!-- Data Flow -->
  <path d="M 250 200 Q 325 180 350 200" stroke="#10b981" stroke-width="3" fill="none" opacity="0.8" stroke-dasharray="5,5">
    <animate attributeName="stroke-dashoffset" values="0;-10" dur="1s" repeatCount="indefinite"/>
  </path>
  
  <path d="M 450 200 Q 525 220 600 200" stroke="#10b981" stroke-width="3" fill="none" opacity="0.8" stroke-dasharray="5,5">
    <animate attributeName="stroke-dashoffset" values="0;-10" dur="1s" repeatCount="indefinite"/>
  </path>
  
  <!-- Title -->
  <text x="400" y="50" text-anchor="middle" fill="white" font-family="Arial" font-size="28" font-weight="bold">Kibertəhlükəsizlik</text>
  
  <!-- Decorative Network Nodes -->
  <circle cx="100" cy="120" r="6" fill="#3b82f6" opacity="0.7"/>
  <circle cx="700" cy="300" r="8" fill="#8b5cf6" opacity="0.6"/>
  <circle cx="50" cy="250" r="5" fill="#10b981" opacity="0.8"/>
  <circle cx="750" cy="180" r="7" fill="#f59e0b" opacity="0.7"/>
  
  <!-- Connection Lines -->
  <line x1="100" y1="120" x2="150" y2="150" stroke="white" stroke-width="1" opacity="0.3"/>
  <line x1="700" y1="300" x2="650" y2="250" stroke="white" stroke-width="1" opacity="0.3"/>
  <line x1="50" y1="250" x2="120" y2="212" stroke="white" stroke-width="1" opacity="0.3"/>
</svg>