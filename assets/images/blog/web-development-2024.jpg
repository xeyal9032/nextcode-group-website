<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="webBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4f46e5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#webBg)"/>
  
  <!-- Laptop Screen -->
  <rect x="250" y="120" width="300" height="180" rx="8" fill="#1f2937"/>
  <rect x="260" y="130" width="280" height="160" fill="#111827"/>
  
  <!-- Code Lines -->
  <rect x="270" y="140" width="60" height="4" fill="#10b981"/>
  <rect x="340" y="140" width="80" height="4" fill="#f59e0b"/>
  <rect x="430" y="140" width="100" height="4" fill="#ef4444"/>
  
  <rect x="270" y="155" width="40" height="4" fill="#8b5cf6"/>
  <rect x="320" y="155" width="120" height="4" fill="#06b6d4"/>
  <rect x="450" y="155" width="70" height="4" fill="#10b981"/>
  
  <rect x="270" y="170" width="90" height="4" fill="#f59e0b"/>
  <rect x="370" y="170" width="60" height="4" fill="#ef4444"/>
  <rect x="440" y="170" width="80" height="4" fill="#8b5cf6"/>
  
  <!-- Floating Elements -->
  <circle cx="150" cy="80" r="25" fill="#10b981" opacity="0.8"/>
  <text x="150" y="88" text-anchor="middle" fill="white" font-family="Arial" font-size="16" font-weight="bold">JS</text>
  
  <rect x="600" y="100" width="50" height="50" rx="8" fill="#f59e0b" opacity="0.8"/>
  <text x="625" y="130" text-anchor="middle" fill="white" font-family="Arial" font-size="14" font-weight="bold">CSS</text>
  
  <polygon points="100,300 130,250 160,300" fill="#ef4444" opacity="0.8"/>
  <text x="130" y="285" text-anchor="middle" fill="white" font-family="Arial" font-size="12" font-weight="bold">HTML</text>
  
  <!-- Title -->
  <text x="400" y="50" text-anchor="middle" fill="white" font-family="Arial" font-size="28" font-weight="bold">Web Development 2024</text>
  
  <!-- Decorative Elements -->
  <circle cx="700" cy="320" r="15" fill="white" opacity="0.3"/>
  <circle cx="80" cy="200" r="20" fill="white" opacity="0.2"/>
  <rect x="650" y="300" width="30" height="30" rx="4" fill="white" opacity="0.25"/>
</svg>