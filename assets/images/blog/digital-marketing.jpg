<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="marketingBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f5576c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#marketingBg)"/>
  
  <!-- Central Chart/Graph -->
  <rect x="300" y="150" width="200" height="120" rx="8" fill="white" opacity="0.9"/>
  
  <!-- Bar Chart -->
  <rect x="320" y="220" width="20" height="30" fill="#3b82f6"/>
  <rect x="350" y="200" width="20" height="50" fill="#10b981"/>
  <rect x="380" y="180" width="20" height="70" fill="#f59e0b"/>
  <rect x="410" y="160" width="20" height="90" fill="#ef4444"/>
  <rect x="440" y="190" width="20" height="60" fill="#8b5cf6"/>
  <rect x="470" y="170" width="20" height="80" fill="#06b6d4"/>
  
  <!-- Social Media Icons -->
  <circle cx="150" cy="100" r="35" fill="#1877f2" opacity="0.9"/>
  <text x="150" y="108" text-anchor="middle" fill="white" font-family="Arial" font-size="16" font-weight="bold">f</text>
  
  <rect x="600" y="80" width="70" height="70" rx="12" fill="#e4405f" opacity="0.9"/>
  <circle cx="635" cy="115" r="15" fill="white"/>
  <circle cx="635" cy="115" r="10" fill="#e4405f"/>
  <circle cx="650" cy="100" r="5" fill="white"/>
  
  <rect x="100" y="280" width="60" height="60" rx="8" fill="#1da1f2" opacity="0.9"/>
  <path d="M 115 310 Q 125 300 135 310 Q 145 320 135 330 Q 125 320 115 310" fill="white"/>
  
  <!-- Email Marketing -->
  <rect x="600" y="250" width="80" height="50" rx="8" fill="#34d399" opacity="0.9"/>
  <path d="M 610 265 L 640 280 L 670 265" stroke="white" stroke-width="3" fill="none"/>
  <rect x="615" y="270" width="50" height="20" rx="3" fill="white" opacity="0.8"/>
  
  <!-- SEO Elements -->
  <circle cx="200" cy="300" r="25" fill="#fbbf24" opacity="0.9"/>
  <text x="200" y="308" text-anchor="middle" fill="white" font-family="Arial" font-size="14" font-weight="bold">SEO</text>
  
  <!-- Analytics -->
  <rect x="650" y="180" width="60" height="40" rx="6" fill="#8b5cf6" opacity="0.9"/>
  <path d="M 660 200 L 670 190 L 680 195 L 690 185" stroke="white" stroke-width="2" fill="none"/>
  
  <!-- Title -->
  <text x="400" y="50" text-anchor="middle" fill="white" font-family="Arial" font-size="28" font-weight="bold">Rəqəmsal Marketinq</text>
  
  <!-- Connection Lines -->
  <path d="M 185 115 Q 250 130 300 165" stroke="white" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 500 180 Q 550 160 600 115" stroke="white" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 225 285 Q 260 270 300 250" stroke="white" stroke-width="2" fill="none" opacity="0.6"/>
  <path d="M 500 230 Q 550 240 600 265" stroke="white" stroke-width="2" fill="none" opacity="0.6"/>
  
  <!-- Decorative Elements -->
  <circle cx="80" cy="150" r="15" fill="white" opacity="0.3"/>
  <circle cx="720" cy="320" r="20" fill="white" opacity="0.25"/>
  <rect x="50" y="50" width="30" height="30" rx="4" fill="white" opacity="0.2"/>
</svg>