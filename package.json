{
  "name": "nextcodegroup-web",
  "version": "1.0.0",
  "description": "NextCode Group - Azərbaycan rəqəmsal marketinq agentliyi web sitesi",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "csslint": "stylelint css/**/*.css",
    "csslint:fix": "stylelint css/**/*.css --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run lint && npm run csslint && npm run test",
    "optimize-images": "imagemin images/**/*.{jpg,jpeg,png} --out-dir=images/optimized",
    "critical-css": "critical index.php --base=./ --css=css/styles.css --inline --minify --out=css/critical.css"
  },
  "keywords": [
    "digital-marketing",
    "web-development",
    "seo",
    "azerbaijan",
    "nextcode"
  ],
  "author": "NextCode Group <info@nextcodegroup.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.4.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "@fortawesome/fontawesome-free": "^6.4.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/vendor/**",
      "!js/**/*.min.js"
    ],
    "coverageDirectory": "coverage/js",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "eslintConfig": {
    "extends": [
      "standard"
    ],
    "env": {
      "browser": true,
      "es2021": true,
      "jest": true
    },
    "globals": {
      "jQuery": "readonly",
      "$": "readonly"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "selector-class-pattern": "^[a-z][a-zA-Z0-9]*(?:[a-z0-9]*(?:-[a-z0-9]+)*)?$",
      "custom-property-pattern": "^[a-z][a-zA-Z0-9]*(?:[a-z0-9]*(?:-[a-z0-9]+)*)?$"
    }
  }
}
