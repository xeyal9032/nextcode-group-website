# NextCode Group - Environment Configuration
# Bu dosya hassas bilgileri içerir ve git'e eklenmemelidir

# Database Configuration
DB_HOST=gtorg.mysql.tools
DB_NAME=gtorg_nextcode
DB_USER=gtorg_nextcode
DB_PASS=;849#dVEyg

# Security Configuration
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your-secret-key-here

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Cache Configuration
CACHE_DRIVER=file
CACHE_TTL=3600

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@nextcodegroup.com
MAIL_PASSWORD=your-mail-password
MAIL_ENCRYPTION=tls

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW=60

# CDN Configuration
CDN_URL=https://cdn.nextcodegroup.com
CDN_ENABLED=true

# Analytics Configuration
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
GOOGLE_TAG_MANAGER_ID=GTM_ID

# Social Media Configuration
FACEBOOK_APP_ID=your-facebook-app-id
INSTAGRAM_CLIENT_ID=your-instagram-client-id
LINKEDIN_CLIENT_ID=your-linkedin-client-id

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true

# Performance Configuration
ASSET_VERSION=1.0.0
COMPRESSION_ENABLED=true
MINIFICATION_ENABLED=true


